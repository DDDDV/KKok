          }
        }
      }
    },
    "This app separates vocals and backing tracks on your device and lets you sing along with imported lyrics. HTDemucs separates audio into vocals, drums, bass, and other; the last three tracks are combined into a backing track. Optional vocal transcription is powered by Argmax WhisperKit and requires your consent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app separates vocals and backing tracks on your device and lets you sing along with imported lyrics. HTDemucs separates audio into vocals, drums, bass, and other; the last three tracks are combined into a backing track. Optional vocal transcription is powered by Argmax WhisperKit and requires your consent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用在设备上分离人声和伴奏，并配合用户导入的歌词唱歌。HTDemucs 将音频拆为 vocals、drums、bass、other，后三轨相加生成伴奏；人声转写由 Argmax WhisperKit 提供，需要用户自愿启用。"
          }
        }
      }
    },
    "This performance has changed. Open it again to make adjustments.": {
